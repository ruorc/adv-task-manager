# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================

# The active minimum log filtering severity boundary (Optional)
# Allowed values: 'info', 'warn', 'error'
# If omitted or invalid: defaults to 'warn' in production, 'info' in development
# VITE_LOG_LEVEL=

# ==============================================================================
# NETWORK & HTTP TRANSPORT CONFIGURATION
# ==============================================================================

# Maximum number of retry attempts before throwing connection errors (Optional)
# Allowed values: from 1 to 5. If omitted or invalid: defaults to 2
# VITE_API_RETRIES=

# Base latency window in milliseconds used for initial backoff scheduling (Optional)
# Allowed values: from 100 to 10000 (10s). If omitted or invalid: defaults to 1000
# VITE_API_DELAY=

# Progressive backoff execution ceiling in milliseconds to protect rate-limiters (Optional)
# Allowed values: from 1000 to 60000 (60s). If omitted or invalid: defaults to 10000
# VITE_API_MAX_DELAY=

# Defensive request execution barrier in milliseconds to prevent pipeline leaks (Optional)
# Allowed values: from 1000 to 120000 (120s). If omitted or invalid: defaults to 15000
# VITE_API_TIMEOUT=

# ==============================================================================
# FIREBASE CONFIGURATION
# ==============================================================================

# Firebase Core API key identifier (Required)
VITE_FIREBASE_API_KEY=

# Authentication routing domain provider (Required)
VITE_FIREBASE_AUTH_DOMAIN=

# Unique project instance nomenclature string (Required)
VITE_FIREBASE_PROJECT_ID=

# Default cloud media and data persistence bucket address (Required)
VITE_FIREBASE_STORAGE_BUCKET=

# Cloud Messaging service push token dispatcher ID (Required)
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Unique client software registry identifier for this deployment (Required)
VITE_FIREBASE_APP_ID=
